<?xml version="1.0" encoding="utf-8"?>
<!--
  Standard budget summary layout (>= 220dp wide).
  Default text values double as the widget picker preview; the provider overwrites them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/budget_widget_card"
    android:clickable="true"
    android:contentDescription="@string/budget_widget_open_description"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_period"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:paddingRight="8dp"
            android:text="@string/budget_widget_preview_period"
            android:textAllCaps="true"
            android:textColor="@color/widget_accent_soft"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/budget_widget_badge_safe"
            android:maxLines="1"
            android:paddingLeft="9dp"
            android:paddingTop="3dp"
            android:paddingRight="9dp"
            android:paddingBottom="3dp"
            android:text="@string/budget_widget_preview_status"
            android:textColor="@color/widget_safe"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:text="@string/budget_widget_preview_title"
        android:textColor="@color/widget_text_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:text="@string/budget_widget_preview_value"
        android:textColor="@color/widget_text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <include
        android:id="@+id/widget_progress_group"
        layout="@layout/widget_progress_bars"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="9dp" />

    <LinearLayout
        android:id="@+id/widget_breakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:baselineAligned="false"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingRight="6dp">

            <TextView
                android:id="@+id/widget_spent_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/budget_widget_preview_spent_label"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_spent_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/budget_widget_preview_spent_value"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_budget_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="@string/budget_widget_preview_budget_label"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_budget_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="@string/budget_widget_preview_budget_value"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="2"
        android:textColor="@color/widget_text_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_actions"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_action_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_primary"
            android:clickable="true"
            android:contentDescription="@string/quick_add_widget_expense_description"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_add"
                android:tint="@color/widget_text_on_action" />

            <TextView
                android:id="@+id/widget_action_add_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/quick_add_widget_expense"
                android:textColor="@color/widget_text_on_action"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_action_refresh"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:background="@drawable/widget_button_neutral"
            android:clickable="true"
            android:contentDescription="@string/budget_widget_refresh_description"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_refresh"
                android:tint="@color/widget_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_footnote_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_footnote_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_offline"
            android:tint="@color/widget_warning"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_footnote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/budget_widget_updated_now"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
