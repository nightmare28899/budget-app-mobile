<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick add, medium layout (190dp - 300dp): the labels stack under the icon so every
  shortcut keeps its name instead of being dropped or truncated.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/budget_widget_background"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/quick_add_expense"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_button_primary"
        android:clickable="true"
        android:contentDescription="@string/quick_add_widget_expense_description"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_expense"
            android:tint="@color/widget_text_on_action" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/quick_add_widget_expense"
            android:textColor="@color/widget_text_on_action"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_add_income"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_success_soft"
        android:clickable="true"
        android:contentDescription="@string/quick_add_widget_income_description"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_income"
            android:tint="@color/widget_safe" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/quick_add_widget_income"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_add_subscription"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_accent_soft"
        android:clickable="true"
        android:contentDescription="@string/quick_add_widget_subscription_description"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_subscription"
            android:tint="@color/widget_accent_soft" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/quick_add_widget_subscription"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
