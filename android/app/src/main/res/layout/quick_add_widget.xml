<?xml version="1.0" encoding="utf-8"?>
<!-- Quick add, wide layout (>= 300dp): three labelled shortcuts in a single row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/budget_widget_background"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/quick_add_expense"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_button_primary"
        android:clickable="true"
        android:contentDescription="@string/quick_add_widget_expense_description"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_expense"
            android:tint="@color/widget_text_on_action" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/quick_add_widget_expense"
            android:textColor="@color/widget_text_on_action"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_add_income"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_success_soft"
        android:clickable="true"
        android:contentDescription="@string/quick_add_widget_income_description"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_income"
            android:tint="@color/widget_safe" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/quick_add_widget_income"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_add_subscription"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="8dp"
        android:layout_weight="1.15"
        android:background="@drawable/widget_button_accent_soft"
        android:clickable="true"
        android:contentDescription="@string/quick_add_widget_subscription_description"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_subscription"
            android:tint="@color/widget_accent_soft" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/quick_add_widget_subscription"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
