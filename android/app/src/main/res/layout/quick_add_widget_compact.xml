<?xml version="1.0" encoding="utf-8"?>
<!-- Quick add, compact layout (< 170dp): the most frequent shortcut keeps a full-width target. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/budget_widget_background"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/quick_add_expense"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_button_primary"
        android:clickable="true"
        android:contentDescription="@string/quick_add_widget_expense_description"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_expense"
            android:tint="@color/widget_text_on_action" />

        <TextView
            android:id="@+id/quick_add_expense_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/quick_add_widget_compact_expense"
            android:textColor="@color/widget_text_on_action"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
